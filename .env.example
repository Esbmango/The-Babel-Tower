# Copy to .env.local and fill in ONE provider. Read by the Vite server only — never shipped to the browser.
# Without a key, The Babel runs fully in local demo mode (lexicon keywords, demo gloss, data-template summary).

# AI_PROVIDER=openai          # openai | deepseek
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# AI_MODEL=                   # required for OpenAI (a current model id); DeepSeek defaults to deepseek-flash
# AI_API_KEY=                # optional generic key override; provider-specific keys above are preferred
# AI_BASE_URL=                # optional, any OpenAI-compatible endpoint

# Voice clips → automatic language detection + transcription (OpenAI-compatible /audio/transcriptions).
# Uses OPENAI_API_KEY if set; otherwise set TRANSCRIBE_API_KEY. Audio is uploaded only with both participants' consent.
# AI_TRANSCRIBE_MODEL=gpt-transcribe   # or whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=
